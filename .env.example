# Application secret
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Development database used by Docker Compose
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=ragdb

# Separate test database used by docker compose test-db and pytest
TEST_POSTGRES_USER=rag_test_user
TEST_POSTGRES_PASSWORD=replace_with_a_different_test_password
TEST_POSTGRES_DB=ragdb_test
TEST_DATABASE_URL=postgresql://rag_test_user:replace_with_a_different_test_password@localhost:5433/ragdb_test

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rag-frontend-lilac.vercel.app
