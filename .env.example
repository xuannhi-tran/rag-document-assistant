# Application secret
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Development database used by Docker Compose
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=ragdb

# Separate test database used by docker compose test-db and pytest
TEST_POSTGRES_USER=rag_test_user
TEST_POSTGRES_PASSWORD=replace_with_a_different_test_password
TEST_POSTGRES_DB=ragdb_test
TEST_DATABASE_URL=postgresql://rag_test_user:replace_with_a_different_test_password@localhost:5433/ragdb_test

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rag-frontend-lilac.vercel.app
# Set to 1 only when behind a reverse proxy (nginx/caddy) that overwrites X-Forwarded-For
TRUST_PROXY=0
# Optional limits (defaults: 10 MB, 3 files, 60 pages, 24h retention)
# MAX_FILE_MB=10
# MAX_FILES_PER_SESSION=3
# MAX_PDF_PAGES=60
# RETENTION_HOURS=24
